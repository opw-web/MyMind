{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MYMIND",
  "version": "2.6.0",
  "identifier": "com.mymind.planner",
  "build": {
    "beforeBuildCommand": "npm run build:tauri",
    "beforeDevCommand": "npm run build:tauri",
    "frontendDist": "../dist/tauri-renderer"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "MYMIND",
      "visible": false,
      "center": true,
      "width": 1440,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600,
      "dragDropEnabled": false,
      "useHttpsScheme": true
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'",
      "headers": {
        "Permissions-Policy": "microphone=(self), camera=(), geolocation=(), display-capture=()"
      },
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../assets/icon.ico", "../assets/icon.png"]
  }
}
